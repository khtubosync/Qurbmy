<?xml version="1.0" encoding="utf-8"?>
<!-- The mark: the green tile and its glyph, as on the desktop. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#3C806A" android:endColor="#22503F" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/qurb_glyph" />
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!-- The share screen's window, drawn the way the app's own dialogs are: the
     raised surface colour, large rounded corners, and room around it. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="16dp"
    android:insetTop="24dp"
    android:insetRight="16dp"
    android:insetBottom="24dp">
    <shape android:shape="rectangle">
        <corners android:radius="28dp" />
        <solid android:color="@color/surface_soft" />
    </shape>
</inset>

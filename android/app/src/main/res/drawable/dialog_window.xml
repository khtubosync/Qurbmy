<?xml version="1.0" encoding="utf-8"?>
<!-- The share screen's window: the elevated material, like the app's sheets. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="16dp"
    android:insetTop="24dp"
    android:insetRight="16dp"
    android:insetBottom="24dp">
    <shape android:shape="rectangle">
        <corners android:radius="@dimen/radius_sheet" />
        <solid android:color="@color/glass_elevated" />
        <stroke android:width="1dp" android:color="@color/glass_edge" />
    </shape>
</inset>

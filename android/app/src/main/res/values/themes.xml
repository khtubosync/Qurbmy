<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The whole app's look, as roles mapped onto Material's.

         NoActionBar because each screen draws its own heading; with the default,
         the window decor would supply a bar as well. -->
    <style name="Theme.Qurb" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_soft</item>
        <item name="colorSecondaryContainer">@color/primary_soft</item>
        <item name="colorOnSecondaryContainer">@color/on_primary_soft</item>
        <item name="colorTertiary">@color/safe</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="colorSurface">@color/paper</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_soft</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_soft</item>
        <item name="colorOutline">@color/line</item>
        <item name="colorOutlineVariant">@color/line</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The share sheet's screen is a dialog rather than a page. It reports one
         short outcome and gets out of the way, and framing it as a dialog keeps
         the app the person was actually using visible behind it. -->
    <style name="Theme.Qurb.Share" parent="Theme.Material3.DayNight.Dialog">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSurface">@color/surface_soft</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_soft</item>
        <item name="colorSurfaceContainerHighest">@color/line</item>
        <item name="android:windowBackground">@drawable/dialog_window</item>
        <!-- The activity's label is what the share sheet puts on its button;
             as a window title it only repeats the screen's own heading in
             smaller type. Both spellings: this is an AppCompat theme, which
             reads the one without the prefix and ignored the other, so the
             title showed anyway. -->
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <!-- Without these the dialog is sized to its text and comes out a
             narrow column, breaking one short sentence across four lines. -->
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <!-- Type: three sizes, and weight and colour doing the rest. -->
    <style name="Text.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Text.Heading" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Text.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Text.Quiet" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/ink_soft</item>
    </style>

    <!-- A card: a surface a step up from the paper, rounded, no shadow. -->
    <style name="Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/corner</item>
        <item name="contentPadding">@dimen/gap_m</item>
    </style>
</resources>

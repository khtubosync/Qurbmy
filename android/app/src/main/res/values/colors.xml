<?xml version="1.0" encoding="utf-8"?>
<!-- The palette: docs/design/direction.md §8, the same as the desktop's.

     Light only for now. Dark is designed after the light one is approved
     (docs/design/brief.md §1), and the app is kept light until then, so the
     night palette of the old design does not return underneath the new one.

     Layouts name roles, never hex values. -->
<resources>
    <color name="bg">#F7F7F4</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_2">#F0F0EC</color>
    <color name="text">#171816</color>
    <color name="text_2">#5F625C</color>
    <color name="text_3">#8A8D86</color>
    <color name="border">#E2E3DD</color>
    <color name="border_strong">#D2D4CD</color>

    <color name="green">#2F6B57</color>
    <color name="green_hover">#285B4A</color>
    <color name="green_pressed">#214B3D</color>
    <color name="green_soft">#E8F0EC</color>
    <!-- The luminous green, only ever faint: the environment and the light
         that means Qurb is moving something (§28). -->
    <color name="glow">#6FAF98</color>
    <color name="glow_faint">#296FAF98</color>

    <color name="healthy">#287052</color>
    <color name="healthy_bg">#E8F3EC</color>
    <color name="attention">#946A24</color>
    <color name="attention_bg">#F7F0DD</color>
    <color name="error">#A3423A</color>
    <color name="error_bg">#F7E9E7</color>
    <color name="neutral">#626A68</color>
    <color name="neutral_bg">#ECEEEC</color>

    <!-- The three glass materials (§6), as fills over the still environment:
         clear for the tab bar, frosted for cards, elevated for sheets. -->
    <color name="glass_clear">#8CFFFFFF</color>
    <color name="glass_frosted">#A6FFFFFF</color>
    <color name="glass_elevated">#F7FCFCFA</color>
    <color name="glass_edge">#B3FFFFFF</color>
    <color name="hairline">#12171816</color>
    <color name="scrim">#33171816</color>

    <!-- The old role names, for the screens that still say them. -->
    <color name="paper">@color/bg</color>
    <color name="surface_soft">@color/surface_2</color>
    <color name="line">@color/border</color>
    <color name="ink">@color/text</color>
    <color name="ink_soft">@color/text_2</color>
    <color name="primary">@color/green</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="primary_soft">@color/green_soft</color>
    <color name="on_primary_soft">@color/green_pressed</color>
    <color name="safe">@color/healthy</color>
    <color name="safe_soft">@color/healthy_bg</color>
    <color name="notice">@color/attention</color>
    <color name="notice_soft">@color/attention_bg</color>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!-- §39: pressed, a little smaller; released, back. Physical but restrained. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:duration="90" android:propertyName="scaleX" android:valueTo="0.98" android:valueType="floatType" />
            <objectAnimator android:duration="90" android:propertyName="scaleY" android:valueTo="0.98" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="180" android:interpolator="@android:interpolator/overshoot" android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" />
            <objectAnimator android:duration="180" android:interpolator="@android:interpolator/overshoot" android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" />
        </set>
    </item>
</selector>

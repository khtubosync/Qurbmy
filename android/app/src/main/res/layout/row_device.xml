<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/touch"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/gap_m"
    android:paddingVertical="14dp">

    <TextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/Text.Body" />

    <TextView
        android:id="@+id/detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_xs"
        android:textAppearance="@style/Text.Quiet" />

    <TextView
        android:id="@+id/keeps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_s"
        android:background="@drawable/badge"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:text="Keeps your files"
        android:textAppearance="@style/Text.Quiet"
        android:textColor="@color/safe"
        android:visibility="gone" />
</LinearLayout>
